# hack/rpm-base-images/build-base-images.sh sets BUILDER_IMAGE.
ARG BUILDER_IMAGE

FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS rpm-builder

ARG BUILD_ARCH=amd64
ARG CENTOS_STREAM_VERSION=9

WORKDIR /workspace
COPY exportserverbase_*_cs${CENTOS_STREAM_VERSION}.tar rpm-tars/

RUN case ${BUILD_ARCH} in \
        amd64|x86_64) BAZEL_ARCH="x86_64" ;; \
        arm64|aarch64|crossbuild-aarch64) BAZEL_ARCH="aarch64" ;; \
        s390x|crossbuild-s390x) BAZEL_ARCH="s390x" ;; \
        *) echo "ERROR: Unsupported BUILD_ARCH: ${BUILD_ARCH}"; exit 1 ;; \
    esac && \
    mkdir -p /rootfs && \
    tar -xf rpm-tars/exportserverbase_${BAZEL_ARCH}_cs${CENTOS_STREAM_VERSION}.tar -C /rootfs \
        --transform='s,^\./var/run/,./run/,x' \
        --overwrite && \
    if [ ! -L /rootfs/var/run ]; then ln -s ../run /rootfs/var/run; fi

RUN echo "nonroot-user:x:1001:1001:nonroot user:/home/nonroot-user:/sbin/nologin" > /rootfs/etc/passwd

FROM scratch

COPY --from=rpm-builder /rootfs/ /
